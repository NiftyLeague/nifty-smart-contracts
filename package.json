{
  "name": "@niftyleague/smart-contracts",
  "type": "module",
  "version": "1.0.0",
  "description": "Nifty League Smart Contracts",
  "author": "Nifty Andy",
  "license": "Apache-2.0",
  "homepage": "https://github.com/NiftyLeague/nifty-smart-contracts#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NiftyLeague/nifty-smart-contracts"
  },
  "bugs": {
    "url": "https://github.com/NiftyLeague/nifty-smart-contracts/issues"
  },
  "scripts": {
    "compile": "hardhat clean && hardhat compile && node scripts/generate-typechain.mjs",
    "build": "bun compile",
    "format:ts": "prettier --ignore-path .prettierignore --write .",
    "format:sol": "prettier --write --plugin=prettier-plugin-solidity \"src/contracts/**/*.sol\"",
    "format": "bun format:ts && bun format:sol",
    "format:check": "prettier --ignore-path .prettierignore --check .",
    "lint:ts": "eslint \"**/*.{ts,js,mjs,cjs}\" --fix",
    "lint:ts:check": "eslint \"**/*.{ts,js,mjs,cjs}\" --max-warnings=0",
    "lint:sol": "solhint \"src/contracts/**/*.sol\" --ignore-path .solhintignore",
    "lint": "bun lint:ts:check && bun lint:sol",
    "type-check": "bun compile && tsc --noEmit",
    "generate:typechain": "node scripts/generate-typechain.mjs",
    "type:check": "bun compile && tsc --noEmit",
    "dev": "hardhat node",
    "start": "hardhat node",
    "test": "bun test bun-tests",
    "test:unit": "bun test bun-tests",
    "test:integration": "bun run test:hardhat",
    "coverage": "node scripts/run-coverage.mjs",
    "test:coverage": "bun coverage && node scripts/check-coverage.mjs",
    "slither": "slither . --checklist --markdown-root ./ > SLITHER.md",
    "generate-merkle-root": "ts-node src/scripts/merkle-distributor/generate-merkle-root.ts",
    "generate-merkle-root:balance-manager": "bun generate-merkle-root --input src/data/dynamodb_account_balances.json",
    "verify-merkle-root": "ts-node src/scripts/merkle-distributor/verify-merkle-root.ts --input src/data/merkle-result.json",
    "deploy:hardhat": "hardhat deploy --network hardhat",
    "deploy:tenderly": "hardhat deploy --network tenderly",
    "deploy:sepolia": "hardhat deploy --network sepolia",
    "deploy:mainnet": "hardhat deploy --network mainnet",
    "deploy:imx:testnet": "hardhat deploy --network imtbl-zkevm-testnet",
    "deploy:imx:mainnet": "hardhat deploy --network imtbl-zkevm-mainnet",
    "export:sepolia": "bun deploy:sepolia && node scripts/export-deployments.mjs sepolia exports/deployments.sepolia.ts",
    "export:mainnet": "bun deploy:mainnet && node scripts/export-deployments.mjs mainnet exports/deployments.mainnet.ts",
    "export:imx:testnet": "bun deploy:imx:testnet && node scripts/export-deployments.mjs imtbl-zkevm-testnet exports/deployments.imxTestnet.ts",
    "export:imx:mainnet": "bun deploy:imx:mainnet && node scripts/export-deployments.mjs imtbl-zkevm-mainnet exports/deployments.imxMainnet.ts",
    "export": "bun export:sepolia && bun export:mainnet && bun export:imx:testnet && bun export:imx:mainnet && prettier --ignore-path .prettierignore --write exports/*.ts",
    "verify:imx:testnet": "bun verify --network imtbl-zkevm-testnet --show-stack-traces",
    "verify:imx:mainnet": "bun verify --network imtbl-zkevm-mainnet --show-stack-traces",
    "verify": "hardhat etherscan-verify",
    "postinstall": "node scripts/setup-oz-symlinks.mjs",
    "test:hardhat": "hardhat test --network hardhat"
  },
  "devDependencies": {
    "@axelar-network/axelarjs-sdk": "^0.21.0",
    "@axelar-network/interchain-token-service": "^2.2.0",
    "@chainlink/contracts": "^1.5.0",
    "@eslint/eslintrc": "^3.3.6",
    "@eslint/js": "^10.0.1",
    "@imtbl/contracts": "^3.1.1",
    "@nomicfoundation/hardhat-ethers": "^4.0.15",
    "@nomicfoundation/hardhat-ethers-chai-matchers": "^3.0.11",
    "@nomicfoundation/hardhat-ledger": "^3.0.10",
    "@nomicfoundation/hardhat-mocha": "^3.1.0",
    "@nomicfoundation/hardhat-network-helpers": "^3.0.11",
    "@nomicfoundation/hardhat-verify": "^3.1.0",
    "@openzeppelin/contracts": "5.6.1",
    "@openzeppelin/contracts-upgradeable": "5.6.1",
    "@openzeppelin/contracts-v4": "npm:@openzeppelin/contracts@4.9.6",
    "@openzeppelin/contracts-upgradeable-v4": "npm:@openzeppelin/contracts-upgradeable@4.9.6",
    "@openzeppelin/hardhat-upgrades": "^4.1.0",
    "@rocketh/core": "0.19.13",
    "@rocketh/deploy": "0.19.18",
    "@rocketh/node": "0.19.22",
    "@rocketh/proxy": "0.19.24",
    "@rocketh/read-execute": "0.19.13",
    "@typechain/ethers-v6": "^0.5.1",
    "@types/chai": "^5.2.3",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.4.0",
    "@types/ramda": "^0.32.0",
    "@typescript-eslint/eslint-plugin": "^8.68.0",
    "@typescript-eslint/parser": "^8.68.0",
    "chai": "^6.2.2",
    "chalk": "^6.0.0",
    "commander": "^15.0.0",
    "dotenv": "^17.4.2",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eth-provider": "^0.13.7",
    "ethers": "^6.17.0",
    "fs": "0.0.1-security",
    "hardhat": "^3.15.0",
    "hardhat-deploy": "^2.0.26",
    "husky": "^9.1.7",
    "lint-staged": "^17.4.1",
    "mocha": "^11.8.0",
    "prettier": "^3.9.6",
    "prettier-plugin-solidity": "^2.4.1",
    "ramda": "^0.32.0",
    "rocketh": "0.19.20",
    "solhint": "^6.2.4",
    "solhint-plugin-prettier": "^0.1.0",
    "solidity-bytes-utils": "^0.8.4",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typechain": "^8.3.2",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": "24.18.0"
  },
  "overrides": {
    "fast-uri": "3.1.5"
  },
  "packageManager": "bun@1.4.0",
  "trustedDependencies": [
    "@arbitrum/nitro-contracts",
    "@axelar-network/axelarjs-sdk",
    "bufferutil",
    "keccak",
    "node-hid",
    "protobufjs",
    "secp256k1",
    "usb",
    "utf-8-validate"
  ]
}
